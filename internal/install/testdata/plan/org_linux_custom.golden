{
  "allowManagedHooksOnly": true,
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "ConfigChange"
            ]
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "PostToolBatch"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "PostToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "PostToolUseFailure"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "SessionEnd"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "Stop"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "SubagentStop"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/ballast/bin/ballast",
            "args": [
              "hook",
              "--client",
              "claude-code",
              "--event",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "denyWrite": [
        "/etc/claude-code/ballast",
        "~/.ballast",
        "./.ballast",
        "**/.ballast",
        "/opt/ballast/bin",
        "/srv/policy",
        "~/.claude/settings*.json",
        "./.claude/settings*.json",
        "**/.claude/settings*.json"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(//etc/claude-code/ballast/**)",
      "Edit(~/.ballast/**)",
      "Edit(./.ballast/**)",
      "Edit(**/.ballast/**)",
      "Edit(//opt/ballast/bin/**)",
      "Edit(//srv/policy)",
      "Edit(//srv/policy/**)",
      "Edit(~/.claude/settings*.json)",
      "Edit(./.claude/settings*.json)",
      "Edit(**/.claude/settings*.json)"
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    {
      "serverName": "github"
    },
    {
      "serverName": "memory"
    }
  ]
}
