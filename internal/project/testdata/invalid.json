    {"id": "inputs-untracked-dotdot", "why": "inputs_untracked globs stay inside the repo", "json": "{\"verify\":[{\"name\":\"t\",\"argv\":[\"x\"],\"inputs_untracked\":[\"../x/**\"]}]}"},
