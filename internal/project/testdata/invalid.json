    {"id": "version-2", "why": "version must be absent or 1", "json": "{\"version\":2,\"verify\":[]}"},
    {"id": "version-0", "why": "version must be absent or 1", "json": "{\"version\":0,\"verify\":[]}"},
    {"id": "name-empty", "why": "name pattern", "json": "{\"verify\":[{\"name\":\"\",\"argv\":[\"x\"]}]}"},
