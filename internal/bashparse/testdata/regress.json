{
  "_comment": "Plan B1 regression set (the PowerShell row lives in psparse/testdata/regress.json) plus extra rows. Rule under test, the explicit-deny no-long-sleep: some node has sleep.known && sleep.seconds >= 60 && !async, and the tool did not set run_in_background. 'git_sub' rows assert node.git.sub instead.",
  "rows": [
    {"cmd": "for i in 1 2 3; do curl -f localhost:8080 && break; sleep 1; done", "want": "miss"},
    {"cmd": "sleep 300", "want": "hit"},
    {"cmd": "while true; do sleep 300; done", "want": "hit"},
    {"cmd": "sleep 300 &", "want": "miss"},
    {"cmd": "sleep 300", "run_in_background": true, "want": "miss"},
    {"cmd": "env X=1 sleep 300", "want": "hit"},
    {"cmd": "timeout 400 sleep 300", "want": "hit"},
    {"cmd": "bash -c 'sleep 300'", "want": "hit"},
    {"cmd": "echo \"sleep 300\"", "want": "miss"},
    {"cmd": "# sleep 300", "want": "miss"},
    {"cmd": "cat <<EOF\nsleep 300\nEOF", "want": "miss"},
    {"cmd": "for i in 1 2 3; do sleep 30; done", "want": "miss"},
    {"cmd": "git -C ../x commit -m m", "git_sub": "commit"},

    {"cmd": "sleep 59", "want": "miss"},
    {"cmd": "sleep 60", "want": "hit"},
    {"cmd": "sleep 1m", "want": "hit"},
    {"cmd": "sleep 0.5h", "want": "hit"},
    {"cmd": "sleep 30 30", "want": "hit"},
    {"cmd": "sleep infinity", "want": "hit"},
    {"cmd": "sleep $N", "want": "miss"},
    {"cmd": "sudo sleep 300", "want": "hit"},
    {"cmd": "nohup sleep 300 &", "want": "miss"},
    {"cmd": "nohup sleep 300", "want": "hit"},
    {"cmd": "(sleep 300) &", "want": "miss"},
    {"cmd": "{ sleep 300; } &", "want": "miss"},
    {"cmd": "echo $(sleep 300)", "want": "hit"},
    {"cmd": "echo $(sleep 300) &", "want": "miss"},
    {"cmd": "sh -c 'sleep 300 &'", "want": "miss"},
    {"cmd": "sh -c 'sleep 300' &", "want": "miss"},
    {"cmd": "sh -c \"bash -c 'sleep 300'\"", "want": "hit"},
    {"cmd": "sh -c \"bash -c 'zsh -c \\\"sleep 300\\\"'\"", "want": "miss"},
    {"cmd": "sleep 300 | cat", "want": "hit"},
    {"cmd": "echo hi && sleep 300", "want": "hit"},
    {"cmd": "while true; do sleep 300; done &", "want": "miss"},
    {"cmd": "echo sleep 300", "want": "miss"},
    {"cmd": "echo 'a'; # sleep 300", "want": "miss"},
    {"cmd": "git -C a -C b --no-pager -c x=y commit", "git_sub": "commit"},
    {"cmd": "sudo git --git-dir=.git log", "git_sub": "log"},
    {"cmd": "env GIT_DIR=x git push", "git_sub": "push"}
  ]
}
