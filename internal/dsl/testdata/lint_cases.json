   ]
  },
  {
   "name": "target weaker than action",
   "patch": {
    "action": "deny",
    "target": "warn"
   },
   "want": [
    "warning:target-weaker-than-action@/rules/0/target"
   ]
  },
  {
   "name": "target stronger than action",
   "patch": {
    "action": "log",
    "target": "deny"
