  {
   "name": "message at the limit",
   "patch": {
    "message": "字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字"
   },
   "want": []
  },
  {
   "name": "inject object without text",
   "patch": {
    "inject": {
     "anchor": "a"
    }
   },
   "want": [
    "error:schema-invalid@/rules/0/inject"
   ]
  },
  {
   "name": "description too long",
   "patch": {
    "description": ""
   },
   "want": [
    "error:schema-invalid@/rules/0/description"
   ]
  },
  {
   "name": "examples need a hit",
   "patch": {
    "examples": [
     {
      "expect": "miss",
      "input": {
       "a": 1
      }
     },
     {
      "expect": "unknown",
      "input": {
       "a": 1
      }
     }
    ]
   },
   "want": [
    "error:examples-missing@/rules/0/examples"
   ]
  },
  {
   "name": "examples need a non-hit",
   "patch": {
    "examples": [
     {
      "expect": "hit",
      "input": {
       "a": 1
      }
     }
    ]
   },
   "want": [
    "error:examples-missing@/rules/0/examples"
   ]
  },
  {
