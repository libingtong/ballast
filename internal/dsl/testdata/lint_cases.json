   ]
  },
  {
   "name": "missing event",
   "patch": {
    "event": null
   },
   "want": [
    "error:bad-event@/rules/0/event"
   ]
  },
  {
   "name": "bad action",
   "patch": {
    "action": "nuke"
   },
   "want": [
    "error:bad-action@/rules/0/action"
   ]
  },
  {
   "name": "bad target",
   "patch": {
    "target": "nuke"
   },
   "want": [
