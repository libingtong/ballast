{
  "_comment": "Additional U1 rows (same shape as normalize.json plus optional glob 'home' and 'rel' rows). Rows carry their own goos so they run on every host.",
  "normalize": [
    {"goos": "linux",   "base": "/repo",              "home": "/home/u",      "in": ".",                              "want": "/repo"},
    {"goos": "linux",   "base": "/repo/sub",          "home": "/home/u",      "in": "../x",                           "want": "/repo/x"},
    {"goos": "linux",   "base": "/repo",              "home": "/home/u",      "in": "/a//b/./c/",                     "want": "/a/b/c"},
    {"goos": "linux",   "base": "/repo",              "home": "/home/u",      "in": "/../..",                         "want": "/"},
    {"goos": "linux",   "base": "/r",                 "home": "/home/u",      "in": "a\\b",                           "want": "/r/a\\b"},
    {"goos": "linux",   "base": "/r",                 "home": "/home/u",      "in": "C:\\Users\\X\\a.go",             "want": "c:/Users/X/a.go"},
    {"goos": "linux",   "base": "/r",                 "home": "/home/u",      "in": "~",                              "want": "/home/u"},
    {"goos": "linux",   "base": "/r",                 "home": "/home/u",      "in": "~user/x",                        "want": "/r/~user/x"},
    {"goos": "linux",   "base": "/r",                 "home": "",             "in": "~/x",                            "want": "/r/~/x"},
    {"goos": "linux",   "base": "/r",                 "home": "/",            "in": "~/x",                            "want": "/x"},
    {"goos": "linux",   "base": "/r",                 "home": "/home/u",      "in": "//srv/share/x",                  "want": "/srv/share/x"},
    {"goos": "linux",   "base": "",                   "home": "/home/u",      "in": "a/../..",                        "want": ".."},
    {"goos": "linux",   "base": "",                   "home": "/home/u",      "in": "a/b",                            "want": "a/b"},
    {"goos": "darwin",  "base": "/Users/u/r",         "home": "/Users/u",     "in": "/Users/U/../u/File.TXT",         "want": "/Users/u/File.TXT"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "c:/",                            "want": "c:/"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "C:",                             "want": "c:/Users/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "D:",                             "want": "d:/"},
    {"goos": "windows", "base": "c:/x",               "home": "c:/Users/x",   "in": "d:foo",                          "want": "d:/foo"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "c:foo",                          "want": "c:/Users/x/foo"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "C:\\a\\..\\..\\..",              "want": "c:/"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\\\?\\C:\\Users\\x",             "want": "c:/Users/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "//?/c:/x/",                      "want": "c:/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\\\?\\UNC\\srv\\share\\f",       "want": "//srv/share/f"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\??\\C:\\Users\\x",              "want": "c:/Users/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\\\srv\\share\\..\\..\\x",       "want": "//srv/share/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\\\srv",                        "want": "//srv"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "\\\\SRV\\Share\\D",               "want": "//SRV/Share/D"},
    {"goos": "windows", "base": "//srv/share/d",      "home": "c:/Users/x",   "in": "e\\f.txt",                       "want": "//srv/share/d/e/f.txt"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "/c",                             "want": "c:/"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "/C/Users/X",                     "want": "c:/Users/X"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "/cygdrive/d/x",                  "want": "d:/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "/c:/Users/x",                    "want": "c:/Users/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "/foo/../c/x",                    "want": "c:/x"},
    {"goos": "windows", "base": "c:/repo",            "home": "c:/Users/x",   "in": "/tmp/x",                         "want": "c:/tmp/x"},
    {"goos": "windows", "base": "",                   "home": "c:/Users/x",   "in": "/tmp/x",                         "want": "/tmp/x"},
    {"goos": "windows", "base": "//srv/share/d",      "home": "c:/Users/x",   "in": "/tmp/x",                         "want": "/tmp/x"},
    {"goos": "windows", "base": "c:/Users/x/repo",    "home": "c:/Users/x",   "in": "..\\x",                          "want": "c:/Users/x/x"},
    {"goos": "windows", "base": "C:\\Users\\X",       "home": "c:/Users/x",   "in": "x",                              "want": "c:/Users/X/x"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "C:\\Users\\X", "in": "~",                              "want": "c:/Users/X"},
    {"goos": "windows", "base": "c:/Users/x",         "home": "c:/Users/x",   "in": "~/.ballast/../.claude",          "want": "c:/Users/x/.claude"},
    {"goos": "windows", "base": "",                   "home": "c:/Users/x",   "in": "a/b",                            "want": "a/b"}
  ],
  "equal": [
    {"goos": "windows", "a": "//SRV/Share/a", "b": "//srv/share/A", "want": true},
    {"goos": "windows", "a": "c:/a",          "b": "c:/a/",         "want": false},
    {"goos": "darwin",  "a": "/a/b",          "b": "/a/b",          "want": true},
    {"goos": "linux",   "a": "/a/b",          "b": "/a/b",          "want": true},
    {"goos": "",        "a": "/a/B",          "b": "/a/b",          "want": false}
  ],
  "rel": [
    {"goos": "windows", "root": "c:/Users/X", "p": "c:/users/x/a/B.go", "want": "a/B.go", "ok": true},
    {"goos": "linux",   "root": "/Users/X",   "p": "/Users/x/a",        "want": "",       "ok": false},
    {"goos": "linux",   "root": "/",          "p": "/a/b",              "want": "a/b",    "ok": true},
    {"goos": "windows", "root": "c:/",        "p": "c:/a",              "want": "a",      "ok": true},
    {"goos": "linux",   "root": "/repo",      "p": "/repo",             "want": ".",      "ok": true},
    {"goos": "linux",   "root": "/repo",      "p": "/repo2/x",          "want": "",       "ok": false},
    {"goos": "linux",   "root": "/repo/a",    "p": "/repo",             "want": "",       "ok": false},
    {"goos": "linux",   "root": "",           "p": "/repo",             "want": "",       "ok": false},
    {"goos": "windows", "root": "//srv/share", "p": "//SRV/share/x/y",  "want": "x/y",    "ok": true},
    {"goos": "windows", "root": "c:/K",       "p": "c:/\u212a/x",       "want": "x",      "ok": true}
  ],
  "globs": [
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/home/u", "cand": ["/home/u/.ballast/state/x"], "want": true},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/home/u", "cand": ["/home/u/.ballastx/x"],      "want": false},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/home/u", "cand": [".ballast/x"],               "want": false},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "",        "cand": ["/home/u/.ballast/x"],      "want": false},
    {"patterns": ["~/.ballast/**", "**/*.go"], "ci": false, "home": "", "cand": ["a.go"],                 "want": true},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/home/u[1]", "cand": ["/home/u[1]/.ballast/x"], "want": true},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/home/u[1]", "cand": ["/home/u1/.ballast/x"],   "want": false},
    {"patterns": ["~/.ballast/**"], "ci": true,  "home": "c:/Users/X", "cand": ["c:/users/x/.BALLAST/a"], "want": true},
    {"patterns": ["~/.ballast/**"], "ci": false, "home": "/",         "cand": ["/.ballast/a"],           "want": true},
    {"patterns": ["~"],             "ci": false, "home": "/home/u",    "cand": ["/home/u"],               "want": true},
    {"patterns": ["**", "!~/.ssh/**"], "ci": false, "home": "/home/u", "cand": ["/home/u/.ssh/id"],       "want": false},
    {"patterns": ["**", "!~/.ssh/**"], "ci": false, "home": "",        "cand": ["/home/u/.ssh/id"],       "want": true},
    {"patterns": ["*.md", "!README.md"], "ci": false, "cand": ["README.md"],                    "want": false},
    {"patterns": ["*.md", "!README.md"], "ci": false, "cand": ["docs/README.md"],               "want": false},
    {"patterns": ["*.md", "!README.md"], "ci": false, "cand": ["docs/a.md"],                    "want": true},
    {"patterns": ["!README.md", "*.md"], "ci": false, "cand": ["docs/a.md"],                    "want": true},
    {"patterns": ["src/**", "!**/gen/**"], "ci": false, "cand": ["/repo/src/gen/x.go", "src/gen/x.go"], "want": false},
    {"patterns": ["src/**", "!**/gen/**"], "ci": false, "cand": ["/repo/src/x.go", "src/x.go"],         "want": true},
    {"patterns": ["src/**"],            "ci": false, "cand": ["/repo/src/x.go"],               "want": false},
    {"patterns": ["./a.go"],            "ci": false, "cand": ["a.go"],                         "want": true},
    {"patterns": ["./a.go"],            "ci": false, "cand": ["sub/a.go", "/repo/a.go"],       "want": false},
    {"patterns": ["/etc/**"],           "ci": false, "cand": ["/etc/passwd"],                  "want": true},
    {"patterns": ["c:/Users/*/.ssh/**"], "ci": true, "cand": ["C:/users/X/.SSH/id_rsa"],       "want": true},
    {"patterns": ["**/*.{go,rs}"],      "ci": false, "cand": ["x/y.rs"],                       "want": true},
    {"patterns": ["**/*.{go,rs}"],      "ci": false, "cand": ["x/y.py"],                       "want": false},
    {"patterns": ["*.go"],              "ci": false, "cand": ["/a/b/c.go"],                    "want": true},
    {"patterns": ["*.go"],              "ci": false, "cand": ["c:/a/b/c.go"],                  "want": true},
    {"patterns": ["*.MD"],              "ci": false, "cand": ["x.md"],                         "want": false},
    {"patterns": ["*.MD"],              "ci": true,  "cand": ["x.md"],                         "want": true},
    {"patterns": ["[A-Z]*.go"],         "ci": true,  "cand": ["x.go"],                         "want": true},
    {"patterns": ["a?c"],               "ci": false, "cand": ["abc"],                          "want": true},
    {"patterns": ["a?c"],               "ci": false, "cand": ["a/c"],                          "want": false},
    {"patterns": ["*"],                 "ci": false, "cand": [],                                "want": false},
    {"patterns": ["**/.claude/**"],     "ci": false, "cand": ["/x/.claude/a", "other"],        "want": true},
    {"patterns": [],                    "ci": false, "cand": ["x"],                            "error": "empty"},
    {"patterns": ["[abc"],              "ci": false, "cand": ["x"],                            "error": "bad-pattern"},
    {"patterns": ["a", "[abc"],         "ci": false, "cand": ["x"],                            "error": "bad-pattern"},
    {"patterns": ["!"],                 "ci": false, "cand": ["x"],                            "error": "bad-pattern"},
    {"patterns": [""],                  "ci": false, "cand": ["x"],                            "error": "bad-pattern"},
    {"patterns": ["a", "!!b"],          "ci": false, "cand": ["x"],                            "error": "bad-pattern"},
    {"patterns": ["!a", "!b"],          "ci": false, "cand": ["x"],                            "error": "only-negation"},
    {"patterns": ["!~/x/**"],           "ci": false, "home": "/h", "cand": ["x"],                "error": "only-negation"}
  ]
}
