{
  "_comment": "U7 pipeline expectations with FAKE ports. 'verdict' is what the fake evaluator returns; 'want' asserts exit code, stdout emptiness/shape, audit record types (in order) and state delta flags. All cases run with client claude-code unless stated. Optional inputs: 'commands' is the CommandList the fake BashParser/PowerShellParser returns for the event's command; 'state_lock_timeout' / 'state_duplicate' make the fake StateStore.Commit report LockTimeout / Duplicate. want.delta.read_paths is the exact normalized ReadPaths of the committed delta (fake PathService: join with cwd + clean).",
  "cases": [
    {"desc": "PreToolUse deny", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}], "reason": "[r] no"},
     "want": {"exit": 0, "stdout_contains": "\"permissionDecision\":\"deny\"", "audit_types": ["hit"], "delta": {"tool_call": true, "dedupe_key": "PreToolUse:toolu_01DwTNHkDtSoGeHhhcksfPsK"}}},
    {"desc": "no decision ⇒ empty stdout", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "audit_types": []}},
    {"desc": "log hit ⇒ empty stdout, would_deny audited", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "log", "hits": [{"rule_id": "r", "action": "log", "target": "deny", "effective": "log"}]},
     "want": {"exit": 0, "stdout": "", "audit_types": ["hit"], "audit_decision": "would_deny"}},
    {"desc": "audit write fails ⇒ fail open", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}]}, "audit_error": true,
     "want": {"exit": 1, "stdout": "", "stderr_prefix": "ballast: "}},
    {"desc": "state lock timeout is not an exception", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}]}, "state_lock_timeout": true,
     "want": {"exit": 0, "stdout_contains": "deny", "audit_types": ["hit", "diag"]}},
    {"desc": "SessionStart injects and may spawn gc", "native": "SessionStart", "stdin": "docs/facts/payloads/bash-ok/01-SessionStart.json",
     "injection": {"text": "Ballast rules", "kinds": ["full"], "full_emitted": true}, "gc_stamp_age_h": 30,
     "want": {"exit": 0, "stdout_contains": "additionalContext", "spawned": ["gc"]}},
    {"desc": "internal compact agent ignored", "native": "SubagentStop", "stdin": "docs/facts/payloads/compact/03-SubagentStop.json",
