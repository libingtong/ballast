{
  "_comment": "U7 pipeline expectations with FAKE ports. 'verdict' is what the fake evaluator returns; 'want' asserts exit code, stdout emptiness/shape, audit record types (in order) and state delta flags. All cases run with client claude-code unless stated. Optional inputs: 'commands' is the CommandList the fake BashParser/PowerShellParser returns for the event's command; 'state_lock_timeout' / 'state_duplicate' make the fake StateStore.Commit report LockTimeout / Duplicate. want.delta.read_paths is the exact normalized ReadPaths of the committed delta (fake PathService: join with cwd + clean).",
  "cases": [
    {"desc": "PreToolUse deny", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}], "reason": "[r] no"},
     "want": {"exit": 0, "stdout_contains": "\"permissionDecision\":\"deny\"", "audit_types": ["hit"], "delta": {"tool_call": true, "dedupe_key": "PreToolUse:toolu_01DwTNHkDtSoGeHhhcksfPsK"}}},
    {"desc": "no decision ⇒ empty stdout", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "audit_types": []}},
    {"desc": "log hit ⇒ empty stdout, would_deny audited", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "log", "hits": [{"rule_id": "r", "action": "log", "target": "deny", "effective": "log"}]},
     "want": {"exit": 0, "stdout": "", "audit_types": ["hit"], "audit_decision": "would_deny"}},
    {"desc": "audit write fails ⇒ fail open", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}]}, "audit_error": true,
     "want": {"exit": 1, "stdout": "", "stderr_prefix": "ballast: "}},
    {"desc": "state lock timeout is not an exception", "native": "PreToolUse", "stdin": "docs/facts/payloads/bash-ok/03-PreToolUse.json",
     "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny"}]}, "state_lock_timeout": true,
     "want": {"exit": 0, "stdout_contains": "deny", "audit_types": ["hit", "diag"]}},
    {"desc": "SessionStart injects and may spawn gc", "native": "SessionStart", "stdin": "docs/facts/payloads/bash-ok/01-SessionStart.json",
     "injection": {"text": "Ballast rules", "kinds": ["full"], "full_emitted": true}, "gc_stamp_age_h": 30,
     "want": {"exit": 0, "stdout_contains": "additionalContext", "spawned": ["gc"]}},
    {"desc": "internal compact agent ignored", "native": "SubagentStop", "stdin": "docs/facts/payloads/compact/03-SubagentStop.json",
     "want": {"exit": 0, "stdout": "", "evaluated": false, "drop_agent": true}},
    {"desc": "Stop flushes eval_summary", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json",
     "state": {"evals": {"r": {"evals": 3, "hits": 1, "would": 0, "unknown": 1}}}, "verdict": {"action": ""},
     "want": {"exit": 0, "stdout": "", "audit_types": ["eval_summary"], "delta": {"flush_evals": true}}},
    {"desc": "SessionEnd drops session", "native": "SessionEnd", "stdin": "docs/facts/payloads/bash-ok/07-SessionEnd.json",
     "want": {"exit": 0, "stdout": "", "drop_session": true}},
    {"desc": "malformed stdin", "native": "PreToolUse", "stdin_raw": "not json",
     "want": {"exit": 1, "stdout": "", "stderr_prefix": "ballast: "}},
    {"desc": "unknown event", "native": "Bogus", "stdin_raw": "{}",
     "want": {"exit": 1, "stdout": "", "stderr_prefix": "ballast: "}},
    {"desc": "codex ask degraded to log", "client": "codex", "native": "PreToolUse", "stdin_raw": "{\"session_id\":\"s\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"ls\"}}",
     "verdict": {"action": "log", "hits": [{"rule_id": "r", "action": "ask", "effective": "log"}]},
     "want": {"exit": 0, "stdout": "", "audit_types": ["hit", "diag"], "audit_detail": "capability_degraded"}},
    {"desc": "codex shell read (sed -n) enters the read set on PostToolUse", "client": "codex", "native": "PostToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t1\",\"tool_input\":{\"command\":\"sed -n '1,80p' src/a.go && cat /repo/src/b.go\"},\"tool_response\":{}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "sed"}, {"lit": "-n"}, {"lit": "1,80p"}, {"lit": "src/a.go"}], "name": "sed", "reads": [{"path": "src/a.go", "via": "sed"}]}, {"argv": [{"lit": "cat"}, {"lit": "/repo/src/b.go"}], "name": "cat", "reads": [{"path": "/repo/src/b.go", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"read_paths": ["/repo/src/a.go", "/repo/src/b.go"]}}},
    {"desc": "dynamic shell read and cd-relative read are not recorded", "client": "codex", "native": "PostToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t2\",\"tool_input\":{\"command\":\"cd sub && cat a.go \\\"$F\\\" /etc/hosts\"},\"tool_response\":{}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "cd"}, {"lit": "sub"}], "name": "cd"}, {"argv": [{"lit": "cat"}, {"lit": "a.go"}, {"lit": "$F", "dynamic": true}, {"lit": "/etc/hosts"}], "name": "cat", "reads": [{"path": "a.go", "via": "cat"}, {"path": "", "dynamic": true, "via": "cat"}, {"path": "/etc/hosts", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"read_paths": ["/etc/hosts"]}}},
    {"desc": "shell reads are ignored on PreToolUse", "client": "codex", "native": "PreToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t3\",\"tool_input\":{\"command\":\"cat src/a.go\"}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "cat"}, {"lit": "src/a.go"}], "name": "cat", "reads": [{"path": "src/a.go", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"tool_call": true, "read_paths": []}}},
    {"desc": "Stop + state lock timeout ⇒ no eval_summary (counts kept for next flush)", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json", "state": {"evals": {"r": {"evals": 3, "hits": 1, "would": 0, "unknown": 1}}}, "verdict": {"action": ""}, "state_lock_timeout": true, "want": {"exit": 0, "stdout": "", "audit_types": ["diag"], "delta": {"flush_evals": true}}}
  ]
}
