     "want": {"exit": 1, "stdout": "", "stderr_prefix": "ballast: "}},
    {"desc": "codex ask degraded to log", "client": "codex", "native": "PreToolUse", "stdin_raw": "{\"session_id\":\"s\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"ls\"}}",
     "verdict": {"action": "log", "hits": [{"rule_id": "r", "action": "ask", "effective": "log"}]},
     "want": {"exit": 0, "stdout": "", "audit_types": ["hit", "diag"], "audit_detail": "capability_degraded"}},
    {"desc": "codex shell read (sed -n) enters the read set on PostToolUse", "client": "codex", "native": "PostToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t1\",\"tool_input\":{\"command\":\"sed -n '1,80p' src/a.go && cat /repo/src/b.go\"},\"tool_response\":{}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "sed"}, {"lit": "-n"}, {"lit": "1,80p"}, {"lit": "src/a.go"}], "name": "sed", "reads": [{"path": "src/a.go", "via": "sed"}]}, {"argv": [{"lit": "cat"}, {"lit": "/repo/src/b.go"}], "name": "cat", "reads": [{"path": "/repo/src/b.go", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"read_paths": ["/repo/src/a.go", "/repo/src/b.go"]}}},
    {"desc": "dynamic shell read and cd-relative read are not recorded", "client": "codex", "native": "PostToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t2\",\"tool_input\":{\"command\":\"cd sub && cat a.go \\\"$F\\\" /etc/hosts\"},\"tool_response\":{}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "cd"}, {"lit": "sub"}], "name": "cd"}, {"argv": [{"lit": "cat"}, {"lit": "a.go"}, {"lit": "$F", "dynamic": true}, {"lit": "/etc/hosts"}], "name": "cat", "reads": [{"path": "a.go", "via": "cat"}, {"path": "", "dynamic": true, "via": "cat"}, {"path": "/etc/hosts", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"read_paths": ["/etc/hosts"]}}},
    {"desc": "shell reads are ignored on PreToolUse", "client": "codex", "native": "PreToolUse", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"tool_name\":\"Bash\",\"tool_use_id\":\"t3\",\"tool_input\":{\"command\":\"cat src/a.go\"}}", "commands": {"shell": "bash", "nodes": [{"argv": [{"lit": "cat"}, {"lit": "src/a.go"}], "name": "cat", "reads": [{"path": "src/a.go", "via": "cat"}]}]}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "delta": {"tool_call": true, "read_paths": []}}},
    {"desc": "Stop + state lock timeout ⇒ no eval_summary (counts kept for next flush)", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json", "state": {"evals": {"r": {"evals": 3, "hits": 1, "would": 0, "unknown": 1}}}, "verdict": {"action": ""}, "state_lock_timeout": true, "want": {"exit": 0, "stdout": "", "audit_types": ["diag"], "delta": {"flush_evals": true}}},
    {"desc": "Stop + duplicate delivery ⇒ no eval_summary", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json", "state": {"evals": {"r": {"evals": 3, "hits": 1, "would": 0, "unknown": 1}}}, "verdict": {"action": ""}, "state_duplicate": true, "want": {"exit": 0, "stdout": "", "audit_types": [], "delta": {"flush_evals": true}}},
    {"desc": "SubagentStop flushes eval_summary then drops the agent", "native": "SubagentStop", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"agent_id\":\"a1\",\"agent_type\":\"Explore\",\"last_assistant_message\":\"ok\"}", "state": {"evals": {"r": {"evals": 2, "hits": 0, "would": 1, "unknown": 0}}}, "verdict": {"action": ""}, "want": {"exit": 0, "stdout": "", "audit_types": ["eval_summary"], "drop_agent": true, "delta": {"flush_evals": true}}},
    {"desc": "single Stop flushes its own evaluation: eval_summary evals == hits", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json", "verdict": {"results": [{"rule_id": "r", "outcome": 2}], "hits": [{"rule_id": "r", "action": "warn", "target": "warn", "effective": "warn", "message": "m"}], "action": "warn", "reason": "[r] m"}, "want": {"exit": 0, "audit_types": ["hit", "eval_summary"], "delta": {"flush_evals": true, "flushed_evals": {"r": {"evals": 1, "hits": 1, "would": 0, "unknown": 0}}}}},
    {"desc": "SubagentStop flushes prior counts plus its own evaluation, then drops the agent", "native": "SubagentStop", "stdin_raw": "{\"session_id\":\"s\",\"cwd\":\"/repo\",\"agent_id\":\"a1\",\"agent_type\":\"Explore\",\"last_assistant_message\":\"ok\"}", "state": {"evals": {"r": {"evals": 2, "hits": 0, "would": 1, "unknown": 0}}}, "verdict": {"results": [{"rule_id": "r", "outcome": 2}, {"rule_id": "q", "outcome": 1}], "hits": [{"rule_id": "r", "action": "log", "target": "deny", "effective": "log"}], "action": "log"}, "want": {"exit": 0, "stdout": "", "audit_types": ["hit", "eval_summary"], "drop_agent": true, "delta": {"flush_evals": true, "flushed_evals": {"r": {"evals": 3, "hits": 0, "would": 2, "unknown": 0}, "q": {"evals": 1, "hits": 0, "would": 0, "unknown": 0}}}}},
    {"desc": "Stop deny renders a block", "native": "Stop", "stdin": "docs/facts/payloads/bash-ok/06-Stop.json", "verdict": {"action": "deny", "hits": [{"rule_id": "r", "action": "deny", "effective": "deny", "message": "verify first"}], "reason": "[r] verify first"}, "want": {"exit": 0, "stdout_contains": "\"decision\":\"block\"", "audit_types": ["hit"], "delta": {"flush_evals": true}}},
