{
  "$schema": "../../schema/rules.v1.json",
  "version": 1,
  "rules": [
    {
      "id": "no-foreground-long-task",
      "description": "pinrule non_blocking 长任务检测(non_blocking.py:76-86)的构建/安装类命令头:cargo build|install、make install|build|all|release|deploy、mvn install|package|deploy、gradle(w) build。命令头与子命令的叉积会多放进几个不存在的组合(如 cargo deploy),无害。shell 的 & 与工具级 run_in_background 都放行。npm/yarn/pnpm/pip 见 no-foreground-install,`python -m pip`/`uv pip` 见 no-foreground-pip-module,docker 见 no-foreground-docker。",
      "action": "log",
      "target": "deny",
      "event": "PreToolUse",
      "match": {
        "run_in_background": false,
        "bash": {
          "cmd": ["cargo", "make", "mvn", "gradle", "gradlew"],
          "args_regex": ["^(?:-\\S+\\s+)*(build|install|all|release|deploy|package)\\b"],
          "async": false
        },
        "ps": {
          "cmd": ["cargo", "make", "mvn", "gradle", "gradlew"],
          "args_regex": ["^(?:-\\S+\\s+)*(build|install|all|release|deploy|package)\\b"],
          "async": false
        }
      },
      "message": "这是耗时较长的构建/安装命令,不要在前台阻塞等待。用 run_in_background 启动,期间继续做别的事,完成时会收到通知。",
      "inject": "构建、安装等耗时命令(cargo build、make、mvn、gradle)用 run_in_background 启动,不要在前台阻塞。",
      "examples": [
        {"name": "cargo build", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "cargo build --release"}}},
        {"name": "make install", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "make install"}}},
        {"name": "maven package with a flag", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "mvn -q package"}}},
        {"name": "gradle wrapper", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "./gradlew build"}}},
        {"name": "cargo with a global flag", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "cargo --locked build"}}},
        {"name": "shell background &", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "cargo build &"}}},
        {"name": "tool-level background", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "cargo build", "run_in_background": true}}},
        {"name": "short command", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "cargo test"}}},
        {"name": "text inside a string", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "echo \"cargo build\""}}},
        {"name": "PowerShell variant", "expect": "hit", "input": {"tool_name": "PowerShell", "tool_input": {"command": "cargo build --release"}}},
        {"name": "dynamic subcommand is unknown", "expect": "unknown", "input": {"tool_name": "Bash", "tool_input": {"command": "make $TARGET"}}}
      ]
    },
    {
      "id": "no-foreground-install",
      "description": "pinrule non_blocking 长任务检测(non_blocking.py:76-86)的包管理器安装:npm install|ci、yarn install、pnpm install、pip install。`npm run`、`yarn build` 等用户脚本不在原列表中,这里同样不拦(non_blocking.py:87-89)。",
      "action": "log",
      "target": "deny",
      "event": "PreToolUse",
      "match": {
        "run_in_background": false,
        "bash": {
          "cmd": ["npm", "yarn", "pnpm", "pip", "pip3"],
          "args_regex": ["^(?:-\\S+\\s+)*(install|ci)\\b"],
          "async": false
        },
        "ps": {
          "cmd": ["npm", "yarn", "pnpm", "pip", "pip3"],
          "args_regex": ["^(?:-\\S+\\s+)*(install|ci)\\b"],
          "async": false
        }
      },
      "message": "依赖安装通常较慢,不要在前台阻塞等待。用 run_in_background 启动,期间继续做别的事。",
      "inject": "依赖安装(npm install、pip install 等)用 run_in_background 启动,不要在前台阻塞。",
      "examples": [
        {"name": "npm install", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "npm install"}}},
        {"name": "npm ci", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "npm ci"}}},
        {"name": "pip install", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "pip install -r requirements.txt"}}},
        {"name": "yarn install with a flag", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "yarn --frozen-lockfile install"}}},
        {"name": "shell background &", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "npm install &"}}},
        {"name": "tool-level background", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "pnpm install", "run_in_background": true}}},
        {"name": "user script is not listed", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "npm run build"}}},
        {"name": "yarn build is not listed", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "yarn build"}}},
        {"name": "PowerShell variant", "expect": "hit", "input": {"tool_name": "PowerShell", "tool_input": {"command": "npm install"}}}
      ]
    },
    {
      "id": "no-foreground-pip-module",
      "description": "no-foreground-install 的补充:pip 经解释器或 uv 调用的写法(`python -m pip install`、`uv pip install`),原实现对整条命令做子串匹配 `pip\\s+install`(non_blocking.py:81)所以会命中。单独成规则,避免 pip 命令头与 python/uv 命令头产生叉积。",
      "action": "log",
      "target": "deny",
      "event": "PreToolUse",
      "match": {
        "run_in_background": false,
        "bash": {
          "cmd": ["python*", "py", "uv"],
          "args_regex": ["^(?:-\\S+\\s+)*-m\\s+pip3?\\s+install\\b", "^pip3?\\s+install\\b"],
          "async": false
        },
        "ps": {
          "cmd": ["python*", "py", "uv"],
          "args_regex": ["^(?:-\\S+\\s+)*-m\\s+pip3?\\s+install\\b", "^pip3?\\s+install\\b"],
          "async": false
        }
      },
      "message": "依赖安装通常较慢,不要在前台阻塞等待。用 run_in_background 启动,期间继续做别的事。",
      "inject": "依赖安装(python -m pip install、uv pip install 等)用 run_in_background 启动,不要在前台阻塞。",
      "examples": [
        {"name": "python -m pip install", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "python -m pip install -r req.txt"}}},
        {"name": "versioned interpreter", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "python3.12 -m pip install x"}}},
        {"name": "uv pip install", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "uv pip install x"}}},
        {"name": "PowerShell variant", "expect": "hit", "input": {"tool_name": "PowerShell", "tool_input": {"command": "python -m pip install x"}}},
        {"name": "shell background &", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "python -m pip install x &"}}},
        {"name": "tool-level background", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "uv pip install x", "run_in_background": true}}},
        {"name": "pip list is not an install", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "python -m pip list"}}},
        {"name": "plain script", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "python3 job.py"}}}
      ]
    },
    {
      "id": "no-foreground-docker",
      "description": "pinrule non_blocking 长任务检测(non_blocking.py:76-86)的 docker 命令头:docker run|build、docker compose up|run|build。与原实现一致,`-d` 不豁免(命令头匹配不区分是否分离运行)。",
      "action": "log",
      "target": "deny",
      "event": "PreToolUse",
      "match": {
        "run_in_background": false,
        "bash": {
          "cmd": ["docker"],
          "args_regex": ["^(?:-\\S+\\s+)*(run|build)\\b", "^(?:-\\S+\\s+)*compose\\s+(up|run|build)\\b"],
          "async": false
        },
        "ps": {
          "cmd": ["docker"],
          "args_regex": ["^(?:-\\S+\\s+)*(run|build)\\b", "^(?:-\\S+\\s+)*compose\\s+(up|run|build)\\b"],
          "async": false
        }
      },
      "message": "docker 的运行/构建可能耗时很长,不要在前台阻塞等待。用 run_in_background 启动,期间继续做别的事。",
      "inject": "docker run/build、docker compose up 用 run_in_background 启动,不要在前台阻塞。",
      "examples": [
        {"name": "docker build", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "docker build -t app ."}}},
        {"name": "docker run", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "docker run --rm app"}}},
        {"name": "compose up", "expect": "hit", "input": {"tool_name": "Bash", "tool_input": {"command": "docker compose up --build"}}},
        {"name": "shell background &", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "docker build -t app . &"}}},
        {"name": "tool-level background", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "docker run --rm app", "run_in_background": true}}},
        {"name": "docker ps", "expect": "miss", "input": {"tool_name": "Bash", "tool_input": {"command": "docker ps"}}},
        {"name": "PowerShell variant", "expect": "hit", "input": {"tool_name": "PowerShell", "tool_input": {"command": "docker build -t app ."}}}
      ]
    }
  ]
}
