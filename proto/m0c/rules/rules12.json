{
  "project": { "exempt": ["docs/**", "**/*.md"] },
  "rules": [
    { "id": "read-before-edit", "event": "PreToolUse", "action": "deny",
      "tool": ["Edit", "MultiEdit", "Write", "NotebookEdit"],
      "when": [ { "pred": "path_exists" }, { "pred": "read_this_session", "not": true } ],
      "message": "先 Read 再修改该文件。", "summary": "改文件前必须先读", "inject": "修改已存在的文件前必须先 Read 它。" },
    { "id": "no-long-sleep", "event": "PreToolUse", "action": "deny", "tool": ["Bash"],
      "bash": { "cmd": ["sleep"], "min_sleep_s": 60, "not_async": true },
      "message": "不要前台长 sleep,请用 run_in_background。", "summary": "禁止前台长 sleep", "inject": "不要在前台 sleep 60 秒以上。" },
    { "id": "evidence-before-commit", "event": "PreToolUse", "action": "deny", "tool": ["Bash"],
      "bash": { "cmd": ["git"], "git_sub": "commit" },
      "when": [ { "pred": "verify_fresh", "not": true } ],
      "message": "提交前需要新鲜的 ballast verify 证据。", "summary": "提交前先 verify", "inject": "git commit 前必须有与待提交内容一致的 ballast verify 通过记录。" },
    { "id": "no-skip-verify", "event": "PreToolUse", "action": "deny", "tool": ["Bash"],
      "bash": { "cmd": ["git"], "git_sub": "commit", "flags": ["--no-verify", "-n"] },
      "message": "不得跳过 git hooks。", "summary": "禁止 --no-verify", "inject": "不得使用 git commit --no-verify。" },
    { "id": "no-tamper-bash", "event": "PreToolUse", "action": "deny", "tool": ["Bash"],
      "bash": { "writes_glob": ["**/.ballast/**", "**/.claude/settings*.json"] },
      "message": "不得通过 Bash 改写 ballast 状态或 Claude 设置。", "summary": "不得篡改受保护路径", "inject": "不得改写 ~/.ballast 或 Claude settings。" },
    { "id": "no-tamper-edit", "event": "PreToolUse", "action": "deny",
      "tool": ["Edit", "MultiEdit", "Write", "NotebookEdit"],
      "path": ["**/.ballast/**", "**/.claude/settings*.json"],
      "message": "不得编辑受保护路径。" },
    { "id": "no-curl-pipe-sh", "event": "PreToolUse", "action": "ask", "tool": ["Bash"],
      "bash": { "pipe_from": ["curl", "wget"], "pipe_to": ["sh", "bash", "zsh"] },
      "message": "检测到 curl | sh,请确认。" },
    { "id": "no-force-push", "event": "PreToolUse", "action": "deny", "tool": ["Bash"],
      "bash": { "cmd": ["git"], "git_sub": "push", "flags": ["--force", "-f"] },
      "message": "不得 force push。", "summary": "禁止 force push" },
    { "id": "no-todo-stub", "event": "PreToolUse", "action": "warn",
      "tool": ["Edit", "MultiEdit", "Write"],
      "input_regex": { "new_string": "\\b(TODO|FIXME|XXX)\\b" },
      "message": "写入内容里含 TODO/FIXME 占位。" },
    { "id": "prompt-skip-tests", "event": "UserPromptSubmit", "action": "warn",
      "text": { "source": "prompt", "regex": "(?i)(跳过测试|skip (the )?tests)", "not_regex": ["(?i)不要跳过"] },
      "message": "提示词要求跳过测试,请确认。" },
    { "id": "claim-needs-evidence", "event": "Stop", "action": "warn",
      "text": { "source": "last_assistant_message", "tail_chars": 400, "regex": "(已完成|全部通过|all tests pass(ed)?|\\bdone\\b)" },
      "when": [ { "pred": "verify_fresh", "not": true } ],
      "message": "声称完成,但没有新鲜的 verify 证据。", "summary": "完成声明需证据" },
    { "id": "secret-in-output", "event": "PostToolUse", "action": "warn",
      "response_regex": "(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)",
      "message": "工具输出中疑似包含密钥。" }
  ]
}
